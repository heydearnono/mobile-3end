<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 手工任务 M2-9：网络权限，见 hints/M2.md -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 手工任务 M2-10：只对 mock 地址放行明文 http，在 <application> 上加一个属性，见 hints/M2.md -->
    <!-- M3 起用自己的 Application 类：进程级初始化（M3 的 StrictMode、M5 的崩溃钩子）放在它的 onCreate 里 -->
    <application
        android:name=".M3EApplication"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- M3 想一想：加上 android:configChanges="orientation|screenSize|screenLayout" 再旋转，看日志有什么不同 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
